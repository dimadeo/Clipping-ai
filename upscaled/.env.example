# .env - 5K/9K upscaling pipeline (copy to .env; never commit). Loaded by upscale_pipeline.py and run_upscale.ps1.
# Precedence: CLI flag > environment > .env > built-in default. If a key appears twice, the LAST line wins.

# ---- Executor: Replicate API (the only executor; there is no self-hosted renderer) ----
REPLICATE_API_TOKEN=r8_replace-me
# 1 = run the model versions pinned in upscale_pipeline.py (reproducible); 0 = always latest
REPLICATE_PIN_VERSIONS=1
# Seconds between prediction status polls (Replicate client setting)
# REPLICATE_POLL_INTERVAL=0.5

# ---- Storage: local filesystem (no upload endpoint) ----
UPSCALE_INPUT_DIR=C:\Users\andre\Upscaled\input
UPSCALE_OUTPUT_DIR=C:\Users\andre\Upscaled\output
UPSCALE_WORK_DIR=C:\Users\andre\Upscaled\work

# ---- Pipeline defaults (any of these can be overridden per run with CLI flags) ----
# auto | real-esrgan | real-esrgan-a100 | clarity | topaz | google
UPSCALE_MODEL=auto
# Optional different model for the last pass, e.g. clarity
# UPSCALE_FINAL_MODEL=clarity
# Long-edge target in px. 9000 = 150 cm at 150 PPI (large-format sharp). 5120 = 5K screens / prints <= 86 cm.
UPSCALE_TARGET_PX=9000
# API passes per image before aborting (9000 px from a small source can take 4)
UPSCALE_MAX_PASSES=4
# 1 = trim overshoot to exactly UPSCALE_TARGET_PX; 0 = keep >= target
UPSCALE_EXACT=1
# png | jpg | webp | tiff | pdf. pdf = one page at print size, lossless image, ICC embedded, trim/bleed boxes; PDF/X-4 output intent when UPSCALE_ICC_TARGET is the shop's printer profile.
# Precedence: --format on the command line > this key > preset default (tiff for printshop, png otherwise)
UPSCALE_FORMAT=pdf
UPSCALE_JPEG_QUALITY=95
# 1 = CodeFormer face-restoration pre-pass at native resolution
UPSCALE_FACE_RESTORE=0
# warn = deliver and flag quality regressions; abort = fail the image on the first flag
UPSCALE_QUALITY_POLICY=warn
# Wall-clock cap per image (seconds)
UPSCALE_BUDGET_SECONDS=1800
# Print sheet. Named: 150x100 100x150 150x150 a0 a1 a2 a3 a4 - or explicit: 60x40cm 24x16in
UPSCALE_PRINT_SIZE=150x100

# ---- Print-shop delivery ----
# With UPSCALE_PRINT_SIZE: derive the pixel target from the sheet at this PPI (150 = large-format sharp).
# UPSCALE_TARGET_PX is the fallback when no sheet/PPI is given.
UPSCALE_PRINT_PPI=150
# default | printshop. printshop = TIFF-LZW, ICC profile + dpi tag embedded, sheet-derived file name,
# <file>_SPEC.txt delivery note, no JSON metadata inside the image file
UPSCALE_PRESET=printshop
# none = keep the image aspect | crop = centred crop to the sheet aspect | pad = white borders to the sheet aspect
UPSCALE_FIT=none
# Mirrored bleed per side in mm at the delivered PPI (0 = none; 3 mm is the usual large-format request)
UPSCALE_BLEED_MM=3
# 1 = mild unsharp mask (radius 0.6, 60%) after the final resize
UPSCALE_SHARPEN=0
# Convert into a specific output profile (path to an .icc). Default: keep the source profile, or embed sRGB
# UPSCALE_ICC_TARGET=C:\Users\andre\Upscaled\AdobeRGB1998.icc

# ---- Texture / grain overlay (v1.3, optional; applied after the final resize, before colour and bleed) ----
# Path to a PNG/TIFF texture tile (repeated over the image), or grain / grain-color for synthetic film grain
# UPSCALE_TEXTURE=C:\Users\andre\Upscaled\textures\paper.png
# multiply | overlay | soft-light (blend mode for a texture file) | grain | grain-color (ignore the file)
# UPSCALE_TEXTURE_MODE=multiply
# 0..1 blend opacity (grain: amplitude). 0.18 is subtle at print size; 0.4+ is clearly visible
# UPSCALE_TEXTURE_STRENGTH=0.18

# ---- Tiling: inputs above the model's MP limit are split into overlapping tiles (seam-free stitch) ----
# auto = only when needed (default) | always | off
UPSCALE_TILING=auto
# Tile edge in source px (1024^2 = 1.05 MP per API call), shared overlap, trimmed border, concurrency
UPSCALE_TILE_SIZE=1024
UPSCALE_TILE_OVERLAP=48
UPSCALE_TILE_MARGIN=8
UPSCALE_TILE_WORKERS=4

# ---- Delivery: optional webhook, one JSON row per finished image (email / store-sync workflow) ----
# Payload = the manifest row: source, status, final_path, input_dims, output_dims, api_passes,
# models_used, est_cost_usd, seconds, quality_flags, print_report, error. Signed with HMAC-SHA256 in
# X-Upscale-Signature when DELIVERY_WEBHOOK_SECRET is set. Failures are logged, never fatal.
# DELIVERY_WEBHOOK_URL=https://your-email-or-store-sync-workflow.example
# DELIVERY_WEBHOOK_SECRET=replace-me

# ---- Print-quality fix + re-check (v1.4): what the Print Quality Auditor flags on delivered files ----
# 1 = toe lift under the substrate ink limit (removes pure RGB black and the crushed floor) + edge-aware
# deband + dither, applied after texture and before colour/bleed. Every printshop delivery is re-checked.
UPSCALE_PRINT_FIX=1
# coated 300% | uncoated 260% | canvas 280% | vinyl 300% | textile 250% -- ink limit for the fix and the check
UPSCALE_PRINT_FIX_SUBSTRATE=canvas
# warn = deliver and flag a file whose re-check is still critical | abort = do not deliver it
UPSCALE_PRINT_QUALITY_POLICY=warn
